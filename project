SELECT 
    m.name AS item_name,
    r.name AS restaurant_name,
    SUM(oi.quantity) AS total_sold
FROM OrderItem oi
JOIN MenuItem m ON oi.item_id = m.item_id
JOIN Restaurant r ON m.restaurant_id = r.restaurant_id
JOIN Orders o ON oi.order_id = o.order_id
WHERE o.order_status = 'Delivered'
GROUP BY m.item_id, m.name, r.name
ORDER BY total_sold DESC
FETCH FIRST 5 ROWS ONLY;

SELECT 
    r.name AS restaurant_name,
    r.cuisine_type,
    COALESCE(SUM(o.total_amount), 0.00) AS total_revenue
FROM Restaurant r
LEFT JOIN Orders o ON r.restaurant_id = o.restaurant_id AND o.order_status = 'Delivered'
GROUP BY r.restaurant_id, r.name, r.cuisine_type
ORDER BY total_revenue DESC;

SELECT 
    da.agent_id,
    da.name AS agent_name,
    da.phone,
    COUNT(o.order_id) AS total_deliveries,
    ROUND(AVG(CAST(o.delivered_datetime AS DATE) - CAST(o.order_datetime AS DATE)) * 24 * 60, 2) AS avg_delivery_minutes
FROM DeliveryAgent da
JOIN Orders o ON da.agent_id = o.agent_id
WHERE o.order_status = 'Delivered' 
  AND o.delivered_datetime IS NOT NULL
GROUP BY da.agent_id, da.name, da.phone
ORDER BY avg_delivery_minutes ASC;

SELECT 
    c.customer_id,
    c.name AS customer_name,
    c.email,
    TO_CHAR(o.order_datetime, 'YYYY-MM') AS order_month,
    COUNT(o.order_id) AS total_orders
FROM Customer c
JOIN Orders o ON c.customer_id = o.customer_id
WHERE o.order_status <> 'Cancelled'
GROUP BY c.customer_id, c.name, c.email, TO_CHAR(o.order_datetime, 'YYYY-MM')
HAVING COUNT(o.order_id) > 3
ORDER BY total_orders DESC;

SELECT 
    restaurant_id,
    name AS restaurant_name,
    cuisine_type,
    avg_rating,
    address
FROM Restaurant
WHERE avg_rating > 4.0
ORDER BY avg_rating DESC;



