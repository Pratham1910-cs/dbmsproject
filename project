CREATE TABLE Customer (
    customer_id NUMBER(10) PRIMARY KEY,
    name VARCHAR2(100) NOT NULL,
    phone VARCHAR2(15) UNIQUE NOT NULL,
    email VARCHAR2(100) UNIQUE NOT NULL,
    registration_date DATE DEFAULT SYSDATE NOT NULL
);

CREATE TABLE CustomerAddress (
    address_id NUMBER(10) PRIMARY KEY,
    customer_id NUMBER(10) NOT NULL,
    address_line VARCHAR2(255) NOT NULL,
    city VARCHAR2(50) NOT NULL,
    postal_code VARCHAR2(10) NOT NULL,
    is_default NUMBER(1) DEFAULT 0 CHECK (is_default IN (0, 1)),
    CONSTRAINT fk_cust_addr FOREIGN KEY (customer_id) 
        REFERENCES Customer(customer_id) ON DELETE CASCADE
);

CREATE TABLE Restaurant (
    restaurant_id NUMBER(10) PRIMARY KEY,
    name VARCHAR2(100) NOT NULL,
    address VARCHAR2(255) NOT NULL,
    cuisine_type VARCHAR2(50) NOT NULL,
    avg_rating NUMBER(3, 2) CHECK (avg_rating >= 0 AND avg_rating <= 5)
);

CREATE TABLE MenuItem (
    item_id NUMBER(10) PRIMARY KEY,
    restaurant_id NUMBER(10) NOT NULL,
    name VARCHAR2(100) NOT NULL,
    price NUMBER(8, 2) NOT NULL CHECK (price > 0),
    category VARCHAR2(20) CHECK (category IN ('Starter', 'Main Course', 'Dessert', 'Beverage')),
    is_available NUMBER(1) DEFAULT 1 CHECK (is_available IN (0, 1)),
    CONSTRAINT fk_menu_rest FOREIGN KEY (restaurant_id) 
        REFERENCES Restaurant(restaurant_id) ON DELETE CASCADE
);

CREATE TABLE DeliveryAgent (
    agent_id NUMBER(10) PRIMARY KEY,
    name VARCHAR2(100) NOT NULL,
    phone VARCHAR2(15) UNIQUE NOT NULL,
    vehicle_number VARCHAR2(20) UNIQUE NOT NULL,
    availability_status VARCHAR2(20) CHECK (availability_status IN ('Available', 'Busy', 'Offline'))
);

CREATE TABLE Orders (
    order_id NUMBER(10) PRIMARY KEY,
    customer_id NUMBER(10) NOT NULL,
    restaurant_id NUMBER(10) NOT NULL,
    agent_id NUMBER(10),
    order_datetime TIMESTAMP NOT NULL,
    delivered_datetime TIMESTAMP,
    order_status VARCHAR2(30) CHECK (order_status IN ('Placed', 'Preparing', 'Out for Delivery', 'Delivered', 'Cancelled')),
    total_amount NUMBER(10, 2) DEFAULT 0.00 NOT NULL,
    CONSTRAINT fk_ord_cust FOREIGN KEY (customer_id) REFERENCES Customer(customer_id),
    CONSTRAINT fk_ord_rest FOREIGN KEY (restaurant_id) REFERENCES Restaurant(restaurant_id),
    CONSTRAINT fk_ord_agent FOREIGN KEY (agent_id) REFERENCES DeliveryAgent(agent_id)
);

CREATE TABLE OrderItem (
    order_id NUMBER(10) NOT NULL,
    item_id NUMBER(10) NOT NULL,
    quantity NUMBER(5) NOT NULL CHECK (quantity > 0),
    unit_price_at_order NUMBER(8, 2) NOT NULL CHECK (unit_price_at_order > 0),
    CONSTRAINT pk_orderitem PRIMARY KEY (order_id, item_id),
    CONSTRAINT fk_oi_ord FOREIGN KEY (order_id) REFERENCES Orders(order_id) ON DELETE CASCADE,
    CONSTRAINT fk_oi_item FOREIGN KEY (item_id) REFERENCES MenuItem(item_id)
);

CREATE TABLE Payment (
    payment_id NUMBER(10) PRIMARY KEY,
    order_id NUMBER(10) UNIQUE NOT NULL,
    payment_mode VARCHAR2(20) CHECK (payment_mode IN ('Cash', 'Card', 'UPI', 'Wallet')),
    amount NUMBER(10, 2) NOT NULL CHECK (amount >= 0),
    payment_status VARCHAR2(20) CHECK (payment_status IN ('Completed', 'Pending', 'Failed', 'Refunded')),
    payment_datetime TIMESTAMP NOT NULL,
    CONSTRAINT fk_pay_ord FOREIGN KEY (order_id) REFERENCES Orders(order_id) ON DELETE CASCADE
);

